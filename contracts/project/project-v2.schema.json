{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lingbi.com/contracts/project/project-v2.schema.json",
  "title": "LingBi Project V2",
  "type": "object",
  "required": [
    "id",
    "name",
    "schema_version",
    "created_at",
    "updated_at",
    "documents"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string"
    },
    "schema_version": {
      "const": 2
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "documents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/document"
      }
    }
  },
  "$defs": {
    "document": {
      "type": "object",
      "required": [
        "id",
        "project_id",
        "title",
        "order",
        "revision",
        "content_hash",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "project_id": {
          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": "string"
        },
        "order": {
          "type": "integer"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "content_hash": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
